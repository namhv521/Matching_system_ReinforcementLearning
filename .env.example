# Copy this file to .env and fill only the values required by your environment.
# Never commit .env or real credentials.

# Application
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO
PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8000","http://127.0.0.1:8000"]

# Database
# Local default (when omitted): sqlite:///data/storage/kltn_matching.db
DATABASE_URL=sqlite:///data/storage/kltn_matching.db

# Optional MongoDB compatibility layer
MONGODB_ENABLED=false
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=kltn_matching

# ML / matching
MATCHING_SEED=42
MATCHING_TEXT_BACKEND=tfidf

# LLM provider: openai_compat or gemini
LLM_PROVIDER=openai_compat
NINEROUTER_BASE_URL=http://localhost:20128/v1
NINEROUTER_API_KEY=
NINEROUTER_MODEL=cx/gpt-5.6-luna

# Optional Google Gemini fallback
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

