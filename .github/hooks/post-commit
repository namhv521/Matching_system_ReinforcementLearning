#!/bin/sh
# Git post-commit hook for KLTN AI Agent audit logging
echo "[Git Hook] Commit recorded: $(git rev-parse --short HEAD)"
python -c "
import sys
try:
    from scripts.log_ai_interaction import log_agent_interaction
    log_agent_interaction(
        session_id='git-hook',
        user_prompt='git commit',
        agent_response='Commit completed',
        tools_used=['git'],
        duration_ms=0.0,
        model_name='system'
    )
except Exception:
    pass
" 2>/dev/null || true
